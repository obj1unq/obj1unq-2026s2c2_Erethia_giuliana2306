import rolando.*
describe "Erethia" {
    test "artefactos en la mochi de Rolando" {
        rolando.encuentraArtefacto(espadaDelDestino)
        rolando.encuentraArtefacto(libroDeHechizos)
        rolando.encuentraArtefacto(collarDivino)
        assert.equals([espadaDelDestino, libroDeHechizos], rolando.artefactosEnLaMochila())
    }
    test "dejar primeros artefactos en el castillo" {
        rolando.encuentraArtefacto(espadaDelDestino)
        rolando.encuentraArtefacto(libroDeHechizos)
        rolando.llegarAlCastillo()
        assert.equals([espadaDelDestino, libroDeHechizos], castillo.artefactos())
        rolando.encuentraArtefacto(collarDivino)
        rolando.llegarAlCastillo()
        assert.equals([espadaDelDestino, libroDeHechizos, collarDivino], castillo.artefactos())
    }
    test "que artefactos tiene rolando" {
        rolando.encuentraArtefacto(collarDivino)
        rolando.encuentraArtefacto(espadaDelDestino)
        rolando.llegarAlCastillo()
        rolando.encuentraArtefacto(armaduraDeAceroValyrio)
        assert.equals([armaduraDeAceroValyrio, collarDivino, espadaDelDestino], rolando.artefactosQueLleva())
        assert.equals(false, rolando.tieneArtefacto(libroDeHechizos))
    }
}

