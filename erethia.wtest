import rolando.*
describe "Erethia" {
    test "artefactos en la mochi de Rolando" {
        rolando.capacidadDeMochila(2)
        rolando.encuentraArtefacto(espadaDelDestino)
        rolando.encuentraArtefacto(libroDeHechizos)
        rolando.encuentraArtefacto(collarDivino)
        assert.equals(#{espadaDelDestino, libroDeHechizos}, rolando.artefactosDeLaMochila())
    }
    test "dejar primeros artefactos en el castillo" {
       rolando.encuentraArtefacto(espadaDelDestino)
       rolando.encuentraArtefacto(libroDeHechizos)
       rolando.llegarAlCastillo()
       rolando.encuentraArtefacto(collarDivino)
       rolando.llegarAlCastillo()
       assert.equals(#{espadaDelDestino, libroDeHechizos,collarDivino}, castillo.artefactos()) 
    }
    test "Saber qué artefactos tiene Rolando" {
        rolando.encuentraArtefacto(espadaDelDestino)
        rolando.encuentraArtefacto(collarDivino)
        rolando.llegarAlCastillo()
        rolando.encuentraArtefacto(armaduraDeAceroValyrio)
        assert.equals(#{armaduraDeAceroValyrio, espadaDelDestino, collarDivino}, rolando.artefactosEnTotal())
    }
    test "Saber la historia de los encuentros con los artefactos" {
        rolando.encuentraArtefacto(espadaDelDestino)
        rolando.encuentraArtefacto(libroDeHechizos)
        rolando.encuentraArtefacto(collarDivino)
        rolando.llegarAlCastillo()
        rolando.encuentraArtefacto(armaduraDeAceroValyrio)
        rolando.encuentraArtefacto(collarDivino)
        assert.equals([espadaDelDestino, libroDeHechizos, collarDivino, armaduraDeAceroValyrio,collarDivino], 
                       rolando.historia())
    }
    test "Comportamiento de los artefactos" {
        rolando.capacidadDeMochila(3)
        rolando.encuentraArtefacto(espadaDelDestino)
        rolando.encuentraArtefacto(armaduraDeAceroValyrio)
        rolando.encuentraArtefacto(collarDivino)
        assert.equals(19, rolando.poderDePelea())
    }
    test "batalla" {
        rolando.capacidadDeMochila(3)
        rolando.encuentraArtefacto(espadaDelDestino)
        rolando.encuentraArtefacto(armaduraDeAceroValyrio)
        rolando.encuentraArtefacto(collarDivino)
        rolando.pelearEnBatalla()
        assert.equals(18, rolando.poderDePelea())
        rolando.pelearEnBatalla()
        assert.equals(21.5, rolando.poderDePelea())
        rolando.pelearEnBatalla()
        assert.equals(24, rolando.poderDePelea())
    }
    test "Libro de hechizos" {
        rolando.encuentraArtefacto(espadaDelDestino)
        rolando.encuentraArtefacto(armaduraDeAceroValyrio)
        rolando.encuentraArtefacto(collarDivino)
        rolando.llegarAlCastillo()
        rolando.encuentraArtefacto(libroDeHechizos)
        libroDeHechizos.agregarHechizo(bendicion)
        libroDeHechizos.agregarHechizo(invisibilidad)
        libroDeHechizos.agregarHechizo(invocacion)
        assert.equals(4, libroDeHechizos.poderQueAporta(rolando))
        rolando.pelearEnBatalla()
        assert.equals(6, libroDeHechizos.poderQueAporta(rolando))
        rolando.pelearEnBatalla()
        assert.equals(7, libroDeHechizos.poderQueAporta(rolando))
        rolando.pelearEnBatalla()
        assert.equals(0, libroDeHechizos.poderQueAporta(rolando))
    }
    test "Enemigos" {
        rolando.capacidadDeMochila(3)
        rolando.encuentraArtefacto(espadaDelDestino)
        rolando.encuentraArtefacto(armaduraDeAceroValyrio)
        rolando.encuentraArtefacto(collarDivino)
        assert.equals(19, rolando.poderDePelea())
        assert.equals([astra,archibaldo], rolando.enemigosQueVence())
        assert.equals(["torre de marfil","palacio de marmol"], rolando.moradasConquistables())
    }
   test "Es poderoso" {
    rolando.modificarPoderBase(10)
    rolando.capacidadDeMochila(3)
    rolando.encuentraArtefacto(espadaDelDestino)
    rolando.encuentraArtefacto(armaduraDeAceroValyrio)
    rolando.encuentraArtefacto(collarDivino)
    assert.equals(29, rolando.poderDePelea())
    assert.equals([caterina, astra, archibaldo], rolando.enemigosQueVence())
    assert.equals(["fortaleza de acero","torre de marfil","palacio de marmol"], rolando.moradasConquistables())
    assert.equals(true, rolando.esPoderoso())
    }
    test "No es poderoso" {
    rolando.capacidadDeMochila(3)
    rolando.encuentraArtefacto(espadaDelDestino)
    rolando.encuentraArtefacto(armaduraDeAceroValyrio)
    rolando.encuentraArtefacto(collarDivino)
    assert.equals(19, rolando.poderDePelea())
    assert.equals([astra, archibaldo], rolando.enemigosQueVence())
    assert.equals(false, rolando.esPoderoso())
    }
    test "Artefacto fatal" {
        rolando.modificarPoderBase(15)
        rolando.encuentraArtefacto(espadaDelDestino)
        rolando.encuentraArtefacto(armaduraDeAceroValyrio)
        rolando.encuentraArtefacto(collarDivino)
        assert.equals(espadaDelDestino, rolando.artefactosParaVencer(astra))
        assert.equals(true, rolando.puedeVencerA(caterina))
    }
}

