import rolando.*
describe "Erethia" {
    test "artefactos en la mochi de Rolando" {
        rolando.encuentraArtefacto(espadaDelDestino)
        rolando.encuentraArtefacto(libroDeHechizos)
        rolando.encuentraArtefacto(collarDivino)
        assert.equals([espadaDelDestino, libroDeHechizos], rolando.artefactosQueLleva())
    }
}