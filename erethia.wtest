import rolando.*
describe "Erethia" {
    test "artefactos en la mochi de Rolando" {
        rolando.encuentraArtefacto(espadaDelDestino)
        rolando.encuentraArtefacto(libroDeHechizos)
        rolando.encuentraArtefacto(collarDivino)
        assert.equals([espadaDelDestino, libroDeHechizos], rolando.artefactosEnLaMochila())
    }
    test "dejar primeros artefactos en el castillo" {
        rolando.encuentraArtefacto(espadaDelDestino)
        rolando.encuentraArtefacto(libroDeHechizos)
        rolando.llegarAlCastillo()
        assert.equals([espadaDelDestino, libroDeHechizos], castillo.artefactos())
        rolando.encuentraArtefacto(collarDivino)
        rolando.llegarAlCastillo()
        assert.equals([espadaDelDestino, libroDeHechizos, collarDivino], castillo.artefactos())
    }
    test "que artefactos tiene Rolando" {
        rolando.encuentraArtefacto(collarDivino)
        rolando.encuentraArtefacto(espadaDelDestino)
        rolando.llegarAlCastillo()
        rolando.encuentraArtefacto(armaduraDeAceroValyrio)
        assert.equals([armaduraDeAceroValyrio, collarDivino, espadaDelDestino], rolando.artefactosQueLleva())
        assert.equals(false, rolando.tieneArtefacto(libroDeHechizos))
    }
   test "historia de encuentros con artefactos" {
    rolando.encuentraArtefacto(espadaDelDestino)
    rolando.encuentraArtefacto(libroDeHechizos)
    rolando.encuentraArtefacto(collarDivino)
    rolando.llegarAlCastillo()
    rolando.encuentraArtefacto(armaduraDeAceroValyrio)
    rolando.encuentraArtefacto(collarDivino)
    assert.equals([espadaDelDestino, libroDeHechizos, collarDivino,
                   armaduraDeAceroValyrio, collarDivino], rolando.historia())
                   }
    test "poder de pelea" {
        rolando.capacidadDeMochila(3)
        rolando.encuentraArtefacto(espadaDelDestino)
        rolando.encuentraArtefacto(armaduraDeAceroValyrio)
        rolando.encuentraArtefacto(collarDivino)
        assert.equals(19, rolando.poderDePelea())
    }
    test "batalla" {
        rolando.cambiarPoderBase(5)
        rolando.capacidadDeMochila(3)
        rolando.encuentraArtefacto(espadaDelDestino)
        rolando.encuentraArtefacto(armaduraDeAceroValyrio)
        rolando.encuentraArtefacto(collarDivino)
        rolando.pelearEnBatalla()
    }
}

/*

#### Ejemplo de batalla: 

- Hacer que Rolando tenga 5 de base y capacidad de 3 artefactos. Entre sus artefactos se encuentran la *espada* 
(que le aporta 5), la *armadura* (aporta 6) y el *collar* (aporta 3).
- Luego de la primer batalla Rolando tiene 6 de base, la espada (aporta 6/2 = 3), la armadura (aporta 6) y el 
collar (aporta 3) 
- Luego de la segunda batalla Rolando tiene 7 de base, la espada (aporta 7/2 = 3.5), la armadura 6 y el collar (3+2=5)
7+3.5+6+5 = 11+7=  18+3.5= 21.5
- Luego de la tercera batalla Rolando tiene 8 de base, la espada (aporta 8/2=4), la armadura 6 y el collar (3+3=6)
*/